{
  "name": "spaceeyes-workspace",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core-sdk",
    "packages/nasa-dynamo",
    "packages/plugin-host",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspace @spaceeyes/nasa-dynamo && npm run build --workspace @spaceeyes/plugin-host && npm run build --workspace @spaceeyes/core-sdk",
    "test": "npm test --workspace @spaceeyes/core-sdk"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  }
}
