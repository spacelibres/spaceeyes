    "gl-matrix": "3.4.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "acorn": "8.19.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
